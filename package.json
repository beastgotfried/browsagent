{
  "name": "browsagent",
  "private": true,
  "version": "0.0.0",
  "description": "A bridge between an AI agent and a live web page. Point at an element, write the problem, get a checked repair.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @browsagent/cli dev",
    "demo": "pnpm --filter demo-app dev",
    "prove": "node scripts/prove-e2e.mjs",
    "demo:kitchen": "pnpm --filter kitchen-sink dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
