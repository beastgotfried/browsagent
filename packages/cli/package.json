{
  "name": "@browsagent/cli",
  "version": "0.0.0",
  "description": "The start command of browsagent.",
  "type": "module",
  "bin": {
    "browsagent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node ./dist/index.js"
  },
  "dependencies": {
    "@browsagent/agent-runner": "workspace:*",
    "@browsagent/context": "workspace:*",
    "@browsagent/index-service": "workspace:*",
    "@browsagent/model": "workspace:*",
    "@browsagent/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
